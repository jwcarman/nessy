<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <!-- Two levels: this module sits under an aggregator, but still inherits from the root. -->
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-memory-notebook</artifactId>
  <name>Nessy Memory Notebook</name>
  <description>Notes an agent keeps for itself, and an index of them in every context</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Test only: Schemas.initialize, which applies the schema the way an application would. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-backend-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test only: a CodecFactory to hand the store, which is what an application's is built on. -->
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-jackson</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real PostgreSQL: H2 coerces a UUID into a TEXT column that PostgreSQL refuses, and hid
         exactly that bug in this store. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
