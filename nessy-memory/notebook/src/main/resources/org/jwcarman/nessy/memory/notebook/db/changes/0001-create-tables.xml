<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    What an agent has been told worth keeping.

    Unlike a claim, this is USER DATA with no other copy: nothing rebuilds a note, so nothing here
    may be treated as scratch or given a retention policy.

    ANSI spellings only, and no reserved words as identifiers.
  -->
  <changeSet id="nessy-notebook-create-nessy_note" author="nessy">
    <createTable tableName="nessy_note">
      <column name="agent_type" type="TEXT">
        <constraints primaryKey="true" primaryKeyName="pk_nessy_note" nullable="false"/>
      </column>
      <column name="agent_id" type="TEXT">
        <constraints primaryKey="true" primaryKeyName="pk_nessy_note" nullable="false"/>
      </column>
      <column name="note_id" type="TEXT">
        <constraints primaryKey="true" primaryKeyName="pk_nessy_note" nullable="false"/>
      </column>
      <column name="hook" type="BYTEA">
        <constraints nullable="false"/>
      </column>
      <column name="body" type="BYTEA">
        <constraints nullable="false"/>
      </column>
      <!--
        Insertion order, which the index the model reads depends on. A note is written once and revised
        in place, so its position never changes and a revision cannot reshuffle the list.
      -->
      <column name="ordinal" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex indexName="nessy_note_ordinal" tableName="nessy_note">
      <column name="agent_type"/>
      <column name="agent_id"/>
      <column name="ordinal"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
