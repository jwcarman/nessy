<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>nessy-agent</artifactId>
  <name>Nessy Agent</name>
  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-jackson2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.continuum</groupId>
      <artifactId>continuum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.continuum</groupId>
      <artifactId>continuum-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-env</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: the host-integration demos (TypedIntentDemo, GovernedTurnDemo) exercise the
         intent feature jar end to end over a real AutonomousHost, host machinery nessy-intent
         itself cannot see (it depends only on nessy-api + nessy-spi). nessy-agent's own main
         artifact carries no such dependency; this is a one-way, test-scope-only edge. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-intent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: SubstrateMemory and VerbatimMemory each run the MemoryContractTest conformance
         suite (remembrance spec §5) against their own instance. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
