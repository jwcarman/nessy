<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-spike-pekko</artifactId>
  <name>Nessy Spike :: Pekko</name>
  <description>THROWAWAY SPIKE. Does Apache Pekko's Cluster Sharding + DurableStateBehavior
    replace the lease/driver/routing plumbing we have been designing by hand? Nothing in the
    reactor may depend on this module and nothing here is API.</description>

  <properties>
    <!-- Pekko 2.0.0-M4. Moved off the 1.7.0 line for ONE reason: 2.0 ships an official
         pekko-serialization-jackson3 built on the `tools.jackson` (Jackson 3) package line,
         which is the only thing that can dissolve the hard Jackson conflict the 1.x spike hit.
         See the dependencyManagement note below. -->
    <pekko.version>2.0.0-M4</pekko.version>
    <!-- The durable-state plugin does NOT exist at M4: 2.0.0-M1 is the only 2.0 release, three
         milestones behind core, and its POM pins pekko-persistence-query to 2.0.0-M1. The
         dependencyManagement below forces every transitive org.apache.pekko artifact back up to
         M4 so exactly one Pekko version is on the classpath. -->
    <pekko-persistence-jdbc.version>2.0.0-M1</pekko-persistence-jdbc.version>
    <!-- This module is a spike: it is never published and never released. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The supported way to keep the core artifacts consistent. Note what it does NOT cover:
           pekko-persistence-jdbc is a separate project on its own release train, so the BOM
           cannot resolve the M1-vs-M4 lag below. It DOES, however, force that plugin's
           transitive pekko-persistence-query from 2.0.0-M1 up to M4, which is the thing that
           actually matters, since dependencyManagement applies to transitive dependencies too. -->
      <dependency>
        <groupId>org.apache.pekko</groupId>
        <artifactId>pekko-bom_2.13</artifactId>
        <version>${pekko.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--  ==================================================================================
           THE 1.x FINDING, AND HOW 2.0 DISSOLVES IT.

           On Pekko 1.7.0 this block pinned the module BACK to jackson-databind 2.21.6, because
           pekko-serialization-jackson registers com.fasterxml.jackson.module.scala.DefaultScalaModule
           and jackson-module-scala enforces a hard databind range at registration time:

             JsonMappingException: Scala module 2.21.6 requires Jackson Databind version
             >= 2.21.0 and < 2.22.0 - Found jackson-databind version 2.22.0

           thrown while the ActorSystem was starting. With the reactor's pinned 2.22.0, Pekko 1.x
           did not boot at all.

           THAT PIN IS NOW GONE, and deliberately so. Pekko 2.0's pekko-serialization-jackson3 is
           built on `tools.jackson.*` (Jackson 3) instead of `com.fasterxml.jackson.databind`, so
           Pekko is not on our Jackson line at ALL and cannot collide with it. This module now
           inherits the reactor's jackson-databind 2.22.0 from the root POM, unmodified, and
           exercises BOTH lines in one JVM (see LmStudioSpikeModel).

           The one artifact both lines share is jackson-annotations, which Jackson 3 deliberately
           kept in the com.fasterxml namespace on the 2.x version scheme, and Pekko 2.0.0-M4
           declares exactly 2.22, which is the root POM's pin. Nothing to reconcile.
           ================================================================================== -->
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-cluster-sharding-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-serialization-jackson3_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-jdbc_2.13</artifactId>
      <version>${pekko-persistence-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-slf4j_2.13</artifactId>
    </dependency>
    <!-- Jackson 2, at the reactor's OWN pinned 2.22.0, inherited from the root POM. Used by
         LmStudioSpikeModel. Under Pekko 1.x this could not have been here at 2.22.0 at all;
         under 2.0 it sits beside Pekko's tools.jackson (Jackson 3) with nothing to reconcile,
         and the live demo exercises both in one JVM. This dependency IS the coexistence test. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-testkit-typed_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PHASE 1's durability: the in-memory journal and durable-state store. Test scope on
         purpose — swapping to Postgres in PHASE 2 must be a config choice, so neither plugin
         may be visible to main code. -->
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-testkit_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>${awaitility.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- MEASURED FINDING, Pekko 2.0 only. 2.0's artery remoting replaced its old
               sun.misc.Unsafe machinery with org.agrona, and Agrona's UnsafeApi reaches for
               jdk.internal.misc.Unsafe, which java.base does not export. Without this flag the
               ActorSystem dies during startup on JDK 16+:

                 java.lang.IllegalAccessError: class org.agrona.UnsafeApi (in unnamed module)
                 cannot access class jdk.internal.misc.Unsafe (in module java.base) because
                 module java.base does not export jdk.internal.misc to unnamed module

               This is not a test-harness quirk: ANY JVM hosting Pekko 2.0 with the cluster
               provider needs this flag on its command line. Pekko 1.7.0 needed no such thing. -->
          <argLine>@{jacocoArgLine} --add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
