<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-spike-pekko</artifactId>
  <name>Nessy Spike :: Pekko (single node)</name>
  <description>THROWAWAY SPIKE, TIER 1. The actor + persistence model on a SINGLE NODE: no
    cluster, no sharding, no distributed data, no Pekko serialization module. Nothing in the
    reactor may depend on this module and nothing here is API.</description>

  <properties>
    <!-- BACK TO 1.x, deliberately (round 3). The only reason round 2 reached for 2.0.0-M4 was
         pekko-serialization-jackson3; dropping Pekko's Jackson entirely (SpikeStateSerializer)
         removed that reason. 1.7.0 is RELEASED, its persistence-jdbc is one minor behind rather
         than three milestones, and it needs no JVM flag: 2.0's artery pulls org.agrona, which
         reaches for jdk.internal.misc.Unsafe and kills the ActorSystem on JDK 16+ unless every
         host JVM passes an add-exports flag. 1.x has none of that. -->
    <pekko.version>1.7.0</pekko.version>
    <pekko-persistence-jdbc.version>1.3.0</pekko-persistence-jdbc.version>
    <!-- Scala 2.13 over Scala 3, measured in round 2: identical jar COUNT, 5.3 MB smaller,
         because every _3 artifact ships .tasty signature metadata a Java consumer never reads
         (pekko-stream_3 carries 6.17 MB of it; pekko-stream_2.13 carries none). -->

    <!-- This module is a spike: it is never published and never released. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.pekko</groupId>
        <artifactId>pekko-bom_2.13</artifactId>
        <version>${pekko.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ===================================================================================
         TIER 1, THE PRIMARY CONFIGURATION.

         Note what is NOT here, and note that its absence is enforced by Maven rather than by
         discipline: no pekko-cluster, no pekko-cluster-sharding-typed, no
         pekko-distributed-data, and no pekko-serialization-jackson. This module cannot compile
         against them even by accident.

         ONE HONEST EXCEPTION, measured rather than assumed: pekko-remote IS on this classpath.
         pekko-persistence-typed pulls it transitively for serialization machinery and there is
         no way to exclude it. Under provider = local it is never constructed and binds nothing;
         SingleNodeRemotingTest asserts the provider's default address has no host and no port,
         so the claim is checked rather than hoped for.

         The sharded runtime lives in nessy-spike-pekko-cluster, which depends on this module
         and adds nothing but a different way to LOOK UP an actor. Both run the same
         DurableStateBehavior and the same test contract.
         =================================================================================== -->
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-jdbc_2.13</artifactId>
      <version>${pekko-persistence-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-slf4j_2.13</artifactId>
    </dependency>

    <!-- OUR Jackson, at the reactor's own pinned 2.22.0, used ONLY inside our own
         SerializerWithStringManifest. Pekko never sees it and imposes no version range on it.
         This is what makes the whole Jackson thread from rounds 1 and 2 disappear. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-testkit-typed_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-testkit_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>${awaitility.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The shared test contract (SpikeRuntimeContract) ships as a test-jar so the cluster
           module can run the IDENTICAL suite against the sharded lookup. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
