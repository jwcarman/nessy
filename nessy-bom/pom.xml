    <!--
        Flattened on the way out, and only this module is.

        Importing a BOM pulls in its *effective* dependencyManagement, after inheritance, and
        nessy-parent imports spring-boot-dependencies and several other BOMs for its own build.
        Published as-is, this BOM re-exported all of them: 2463 managed entries, 32 of them
        Nessy's, so a consumer importing this BOM to align Nessy's artifacts had its Spring Boot,
        Jackson, JUnit and Netty versions decided for it too.

        bom mode writes the pom that is installed and deployed without the parent and with only
        the dependencyManagement declared here. The build still inherits normally, so
        versions:set, the sonar: prefix and the formatting and licence checks all reach this
        module like any other. occlude-bom is set up the same way.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
