<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This module deliberately has NO <parent>.

        A child inherits its parent's dependencyManagement, and importing a BOM pulls in that
        BOM's *effective* dependencyManagement — after inheritance. Because nessy-parent imports
        spring-boot-dependencies and several other BOMs for its own build, inheriting from it made
        nessy-bom re-export all of those to every consumer: 2463 managed entries, of which 32 were
        nessy's own. A consumer importing this BOM to align Nessy's artifacts was silently having
        its Spring Boot, Jackson, JUnit and Netty versions decided for it too.

        Measured, not assumed: guvnor pins Spring Boot 4.1.1 in its own parent, imports nessy-bom
        above Boot's own BOM, and resolved Boot 4.0.5 — a version it never names anywhere.

        A published BOM must not inherit dependencyManagement. junit-bom,
        spring-boot-dependencies, testcontainers-bom and micrometer-bom are all parentless for the
        same reason, and codec-bom was fixed this way before this one was.

        The consequence is that everything this module needs is declared here: coordinates,
        licence, developer, scm, and the plugins that publish it.
    -->
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-bom</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Nessy BOM</name>
    <description>Bill of Materials for Nessy — version alignment for consumers</description>
    <url>https://github.com/jwcarman/nessy</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>jwcarman</id>
            <name>James Carman</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/jwcarman/nessy</url>
        <connection>scm:git:git@github.com:jwcarman/nessy.git</connection>
        <developerConnection>scm:git:git@github.com:jwcarman/nessy.git</developerConnection>
    </scm>

    <dependencyManagement>
        <dependencies>
            <!-- Every library the reactor publishes, in reactor order. Examples are not
                 libraries and are not here; a module held out of the reactor (nessy-testing,
                 today) comes back here the day it comes back to the build. -->
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-backend-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-backend-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-backend-inmemory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-prompt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-prompt-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-prompt-mustache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-embedding-openai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-embedding-gemini</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-embedding-bedrock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-embedding-voyage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-inference-openai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-inference-anthropic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-inference-gemini</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-inference-bedrock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-memory-notebook</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-planning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-memory-summarizing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-memory-episodic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-tool-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-narration-odyssey</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-approval-intent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-approval-policy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-approval-policy-opa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-approval-risk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.nessy</groupId>
                <artifactId>nessy-console</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Formatting and licence checks, which would otherwise have come from the parent this
         module cannot have. Without them `spotless:check` at the reactor root fails here with an
         unresolvable goal prefix rather than a formatting problem. -->
    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.2</version>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <inlineHeader><![CDATA[Copyright © ${project.inceptionYear} James Carman

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
                            <includes>
                                <include>pom.xml</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Publishing, which would otherwise have come from the parent this module cannot have. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
