<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-spring-boot-starter</artifactId>
  <name>Nessy Spring Boot Starter</name>
  <description>src-less dependency aggregator: add this to a Spring Boot application to pull in Nessy's autoconfiguration and core API in one line.</description>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- This module is deliberately src-less (a dependency aggregator, no src/main/java at
           all), so both plugins below would otherwise skip their release-profile executions
           outright (maven-source-plugin's own default) or produce nothing to archive
           (maven-javadoc-plugin, once there's no source path to scan) — leaving the module's
           Maven Central Portal publication without the -sources.jar / -javadoc.jar every
           non-pom artifact there is required to carry. forceCreation makes the source plugin
           build an empty sources jar regardless; the empty overview forces the javadoc plugin
           to do the same instead of silently producing nothing. Boot's own starter poms (e.g.
           spring-boot-starter-web) are the same src-less shape and force the same pair for the
           same reason. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <sourcepath>${project.basedir}/src/main/javadoc</sourcepath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
