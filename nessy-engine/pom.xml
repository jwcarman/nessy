<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-engine</artifactId>
  <name>Nessy Engine</name>
  <description>The actor runtime behind a Harness: sharded agents, one turn at a time, tool calls with approval and execution phases.</description>

  <dependencyManagement>
    <dependencies>
    <!-- Spring JDBC as a LIBRARY: the engine owns its own bookkeeping (claims, reminders) and
         builds it over a DataSource. JdbcClient needs no ApplicationContext and no Spring Boot. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <!-- TEST only. Nothing in main code uses H2, and at compile scope it reached every
         application through the starter: adding spring-boot-starter-jdbc without a datasource URL
         then gave Boot an embedded H2, JdbcBackendAutoConfiguration a backend over it, and
         Schemas.initialize a PostgreSQL DDL script to run into it. The engine's SQL is
         PostgreSQL's; its tests use real PostgreSQL for that reason. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-tracing-bom</artifactId>
        <version>${micrometer-tracing.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The schema generator's test only: proof that an application can register modules of its
         own and have their constraints reach the schema a model is shown. -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jakarta-validation</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Schema generation, which is an implementation detail of this module. It lived in
         nessy-api until the day someone noticed that every tool author compiling against the
         public API was inheriting a JSON-schema library, plus classmate, to use a class only this
         module ever constructs. -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>

    <!-- The extraction live test only: a real provider, to find out whether a model records
         what it is shown. Nothing in the engine needs one; an application brings its own. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-openai</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The default direct-harness factory's fallback backend, for a caller with no database:
         DefaultDirectHarnessFactory builds one itself when the caller supplies no DirectBackend. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-backend-inmemory</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Tests only: EngineFixture and the harness tests build a real JDBC backend against
         PostgreSQL, and StorageCodecTest exercises the codec that lives beside it. Nothing in this
         module's main code constructs one; that lives in nessy-spring-boot's autoconfiguration
         and in applications that build their own harness. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-backend-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The provider contracts: InferenceProvider/InferenceRequest/InferenceResult and their
         options, which nessy-api no longer brings in transitively now that the dependency runs
         the other way. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-embedding-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The event grammar, AgentEvents/Locks/Payloads: what a backend implements, and what the
         harnesses are typed on. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-backend-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Schemas, for the tests: nothing in this module's main code uses nessy-spi any more, but
         the tests need Schemas.initialize to stand up a real schema against H2. Left at compile
         scope rather than test scope because several downstream modules (the autoconfigure and
         console modules, notably) reach Schemas transitively through this dependency rather than
         declaring their own; narrowing it here would silently break their compile. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spring as a LIBRARY, not a framework: TaskScheduler for the effect poller. No
         ApplicationContext is required to use the engine. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.uuid</groupId>
      <artifactId>java-uuid-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Observations, not tracing. The engine names no Tracer, no Propagator and no Span: which
         bridge sits underneath — OpenTelemetry, Brave, none — is the application's business, and
         an engine with no observability stack runs against a no-op registry. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-observation</artifactId>
    </dependency>
    <!-- Carries the current observation onto the threads listeners are told on, so background
         work appears beneath the turn that caused it. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>context-propagation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real PostgreSQL for the integration tests. The queries this engine rests on are
         PostgreSQL's own: FOR UPDATE SKIP LOCKED, LEAST, and parameters H2 accepts that
         PostgreSQL refuses. A test on H2 would pass against exactly the bugs that matter. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.engine</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
