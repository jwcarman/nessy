<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-testing</artifactId>
  <name>Nessy Testing</name>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
    </dependency>
    <!-- ScriptedApprover/RecordingApprover speak the approval vocabulary (Approver, ApprovalContext,
         ApprovalOutcome, ApprovalRequest), which lives in nessy-api, not nessy-spi. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-api</artifactId>
    </dependency>
    <!-- MemoryContractTest is a main-scope class that imports only the annotation/assertion API,
         never the engine (mirrors nessy-tck's own convention, pom.xml's dependencyManagement
         comment on junit-jupiter-api): a third-party Memory extends it directly, so its own
         classpath must not gain junit-jupiter-engine just from depending on this artifact. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- nessy-testing is a test-support library consumed from
                   both module path and classpath; it does not need a full
                   module-info.java of its own, so it is published as a
                   named automatic module instead. -->
              <Automatic-Module-Name>org.jwcarman.nessy.testing</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
