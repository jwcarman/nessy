<!--
  What a test run is allowed to say, for every module: surefire points logback here.

  One file rather than one per module, because the modules that had none fell back to logback's
  own default, which is root DEBUG. With Testcontainers that means every Docker API call, every
  HTTP header and every connection the pool opens, and a build nobody can read is a build whose
  failures nobody finds.

  WARN by default. A test that needs to see something turns its own logger up, in its own module.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
