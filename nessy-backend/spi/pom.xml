<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.7.0-SNAPSHOT</version>
    <!-- Two levels: this module sits under an aggregator, but still inherits from the root. Without
         this, Maven looks for the parent in ../pom.xml, finds nessy-backend, and fails to resolve
         nessy-parent at all. A reactor build from the root hides that, because it resolves parents
         from the projects it already loaded; building this module on its own does not. -->
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-backend-spi</artifactId>
  <name>Nessy Backend SPI</name>
  <description>What implementing a Backend means: where an agent's events and payloads live, and how a caller keeps two of them from running the same work at once. The sealed event grammar lives here too, because a backend cannot store what it cannot see.</description>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      For Failure alone: AgentEvent.InferenceFailed carries it, and it also lives in
      InferenceResult.Fault on the provider side. It stayed in nessy-inference-spi rather than
      moving to nessy-api (2026-09-26 closure review, James unresolved) because no user ever
      touches it; that leaves this module depending on the SPI beside it until James rules on
      where a type both SPIs need and no user does belongs.
    -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.backend.spi</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
