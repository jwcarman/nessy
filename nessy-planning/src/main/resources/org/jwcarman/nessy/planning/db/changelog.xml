<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    The tables this module owns, run by migratory as META-INF/migratory.properties declares.

    One file per change, included here in order. A change to a table is a new file and a new
    include at the end: an included file never moves and a released changeset is never edited,
    because Liquibase knows a changeset by its id, its author and its file's path.
  -->
  <include file="changes/0001-create-tables.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
