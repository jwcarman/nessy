<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-autoconfigure</artifactId>
  <name>Nessy Autoconfigure</name>
  <description>Spring Boot auto-configuration for Nessy. One module with per-area @AutoConfiguration classes gated by @ConditionalOnClass — users pick features by adding the corresponding nessy-* module to their pom; the matching autoconfig activates on its classpath trigger.</description>

  <properties>
    <!-- Compatibility baseline: Boot 4.x. Pinned to the same 4.1.0 release nessy-examples/chat-web
         builds against so a consumer pulling both this starter and the example's recipe never sees
         two different Boot BOMs disagree. Bump this only alongside that module's own pin. -->
    <spring-boot.version>4.1.0</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring enters the reactor only here: this import, and nowhere else in nessy-autoconfigure. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- Optional feature code modules: compile-time for autoconfig references; runtime activation
         gated by @ConditionalOnClass. Users bring these onto their classpath to light up the
         corresponding autoconfig. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-openai</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-store-jdbc</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Tests: nessy-model-anthropic and nessy-model-openai are already compile-scope above
         (optional only changes what propagates to consumers, not this module's own classpath), so
         both provider jars are present here without a separate test-scope declaration — "on the
         classpath" is the test default; classpath-absent cases use Spring's FilteredClassLoader
         instead of a separate module. A duplicate test-scope redeclaration here would win over the
         compile-scope one (last-declared-scope-wins for repeated dependency coordinates), demoting
         both out of main's compile classpath and breaking the main sources' own build. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test-autoconfigure</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- The house bans mocking libraries (no test doubles from a framework); Boot's test
             starter pulls Mockito in transitively, so it is excluded explicitly. -->
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.autoconfigure</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
