<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-store-tck</artifactId>
  <name>Nessy Store TCK</name>
  <description>The technology-compatibility kit every ConversationStore/Parks/Transcript/SummaryStore implementation must pass, published as a main-scope artifact so third-party store implementers can certify against it.</description>

  <properties>
    <!-- This module's main scope IS test code by nature, the same shape as JUnit itself: the
         contracts under src/main/java are abstract JUnit/AssertJ test classes shipped as
         production code on purpose (see the dependency comment below), not application logic.
         Sonar's default source/test split has no third bucket for "production-scoped test
         code", so java:S5960 (assertions in "production" code), java:S100 (JUnit's own
         snake_case-adjacent contract method names), and java:S1192 (literal duplication Sonar
         only frowns on outside tests) all fire here on code that is, in substance, entirely
         test code. Reclassifying both source roots as sonar.tests — rather than excluding the
         rules — tells the scanner the truth about what this module is; sonar.sources is left
         empty on purpose, the documented way to tell the Maven scanner "there is no production
         source root here" (see docs.sonarsource.com/.../sonarscanner-for-maven). -->
    <sonar.sources></sonar.sources>
    <sonar.tests>src/main/java,src/test/java</sonar.tests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-core</artifactId>
    </dependency>
    <!-- Main scope, not test: the contracts are abstract JUnit/AssertJ-based test classes
         shipped as production code so a store implementer can depend on this artifact and
         extend them directly. Only the API surface the contracts import, never the engine
         (each consumer supplies its own junit-jupiter-engine at test scope). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.store.tck</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
