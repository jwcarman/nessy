<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jwcarman.nessy</groupId>
  <artifactId>nessy-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Nessy</name>
  <description>An AI agent harness framework for Java</description>
  <url>https://github.com/jwcarman/nessy</url>
  <inceptionYear>2026</inceptionYear>

  <developers>
    <developer>
      <id>jwcarman</id>
      <name>James Carman</name>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A business-friendly OSS license</comments>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/jwcarman/nessy</url>
    <connection>scm:git:git@github.com:jwcarman/nessy.git</connection>
    <developerConnection>scm:git:git@github.com:jwcarman/nessy.git</developerConnection>
  </scm>

  <modules>
    <module>nessy-bom</module>
    <module>nessy-core</module>
    <module>nessy-testing</module>
    <module>nessy-tck</module>
    <module>nessy-model-anthropic</module>
    <module>nessy-model-openai</module>
    <module>nessy-model-gemini</module>
    <module>nessy-model-bedrock</module>
    <module>nessy-model-env</module>
    <module>nessy-jdbc</module>
    <module>nessy-tool-mcp</module>
    <module>nessy-autoconfigure</module>
    <module>nessy-spring-boot-starter</module>
    <module>nessy-console</module>
    <module>nessy-examples</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <anthropic.version>2.53.0</anthropic.version>
    <openai.version>4.50.0</openai.version>
    <!-- Google's Gen AI Java SDK (Gemini Developer API + Vertex AI), GA line. Current
         release as of this module's creation (2026-08-15); see java-genai's GitHub
         releases for newer lines. -->
    <google-genai.version>1.66.0</google-genai.version>
    <!-- AWS SDK for Java v2 (bedrockruntime, Converse/ConverseStream). Managed via the SDK's
         own BOM (like micrometer/testcontainers below) rather than a single artifact version,
         since bedrockruntime pulls sibling AWS modules (regions, auth, sdk-core, netty-nio-client)
         that must resolve to one consistent line. Newest stable line on Maven Central as of this
         module's creation (2026-08-16). -->
    <awssdk.version>2.46.7</awssdk.version>
    <jackson.version>2.22.0</jackson.version>
    <!-- jackson-annotations diverged from jackson-databind's version scheme
         starting with the 2.22 line (no patch digit) — kept as a separate
         property so each artifact resolves to a version that actually
         exists. -->
    <jackson-annotations.version>2.22</jackson-annotations.version>
    <!-- victools 5 migrated jsonschema-generator's ObjectNode return types from
         com.fasterxml.jackson.databind to tools.jackson.databind (Jackson 3),
         breaking Schemas.java's direct assignment to a Jackson 2 ObjectNode.
         Held at 4.38: victools 5 breaks Schemas.java (Jackson 2 -> 3 node type
         migration) -->
    <victools.version>5.0.0</victools.version>
    <!-- Matches the slf4j-api version victools pulls transitively. -->
    <slf4j.version>2.0.16</slf4j.version>
    <logback.version>1.6.1</logback.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <micrometer.version>1.16.2</micrometer.version>
    <jug.version>5.2.0</jug.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <!-- Held at the 1.21 line deliberately: testcontainers 2.0 renamed every module artifact
         (org.testcontainers:postgresql -> org.testcontainers:testcontainers-postgresql) and moved
         the container classes to per-module packages. 2.0.x still ships the old
         org.testcontainers.containers.PostgreSQLContainer<?> shape nessy-jdbc's container
         test relies on as a deprecated shim, so this isn't a compatibility blocker — migrating is
         a small deferred follow-up, not a reason to skip 2.0 forever. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Condition-based waiting for concurrency tests (S2925: no Thread.sleep in tests). Managed
         here directly, unlike nessy-autoconfigure, which inherits the version from its own Boot
         BOM import — nessy-console pulls no Spring BOM at all. -->
    <awaitility.version>4.3.0</awaitility.version>
    <postgresql.version>42.7.13</postgresql.version>
    <!-- The MCP Java SDK's 2.0.0 line splits its JSON backend into a separate artifact
         (mcp-json-jackson2 vs. mcp-json-jackson3); nessy-tool-mcp pulls the core artifact
         plus the jackson2 backend explicitly rather than the `mcp` facade, which defaults
         to jackson3 (com.fasterxml.jackson.core's Jackson 2 line is what the rest of this
         repo, including ToolSpec's ObjectNode, is built on). -->
    <mcp-sdk.version>2.0.0</mcp-sdk.version>

    <!-- Test groups the default build skips. Override to empty to run them:
         ./mvnw test -Dnessy.excludedGroups= -->
    <nessy.excludedGroups>live,container</nessy.excludedGroups>

    <!-- exec-maven-plugin's `java` goal has no lifecycle binding of its own: invoked bare from the
         command line (`mvn exec:java`), Maven runs it once per project in the resolved reactor, not
         just the one named by -pl. In an -am build that reactor always includes this root aggregator
         and every intermediate one, none of which configure `mainClass` — so the bare goal fails here
         before it ever reaches the example that wanted it. Defaulting exec.skip to true here makes
         every project a no-op for that goal by default; the one or two example modules that actually
         run `exec:java` (hello, chat-cli) override it back to false in their own pom.

         mainClass is a required parameter that Maven validates before the mojo's own skip check ever
         runs, so exec.skip alone is not enough — every project needs *some* resolvable value here too,
         even though skip=true means it is never actually loaded. This placeholder is that value; the
         same opting-in modules override it to their own main class. -->
    <exec.skip>true</exec.skip>
    <exec.mainClass>none</exec.mainClass>

    <!-- Build plugin versions (pinned explicitly since this POM has no parent
         to inherit plugin management from) -->
    <spotless.version>3.9.0</spotless.version>
    <license.plugin.version>5.1.1</license.plugin.version>
    <source.plugin.version>3.4.0</source.plugin.version>
    <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
    <gpg.plugin.version>3.2.8</gpg.plugin.version>
    <sonatype.plugin.version>0.11.0</sonatype.plugin.version>
    <jacoco.version>0.8.15</jacoco.version>
    <sonar.plugin.version>5.5.0.6356</sonar.plugin.version>
    <!-- Populated by the jacoco-maven-plugin prepare-agent execution in the
         ci profile; empty by default so surefire's argLine stays valid when
         the profile is inactive. -->
    <jacocoArgLine></jacocoArgLine>

    <!-- License Header Configuration -->
    <license.owner>James Carman</license.owner>

    <!-- SonarCloud -->
    <sonar.organization>jwcarman</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.projectKey>jwcarman_nessy</sonar.projectKey>
    <sonar.coverage.exclusions>nessy-examples/**</sonar.coverage.exclusions>
    <!-- nessy-examples are console demo apps where stdout/stderr IS the product;
         excluded from analysis rather than suppressing individual S106 issues. -->
    <sonar.exclusions>nessy-examples/**</sonar.exclusions>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.nessy</groupId>
        <artifactId>nessy-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.nessy</groupId>
        <artifactId>nessy-core</artifactId>
        <version>${project.version}</version>
        <classifier>tests</classifier>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.anthropic</groupId>
        <artifactId>anthropic-java</artifactId>
        <version>${anthropic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.openai</groupId>
        <artifactId>openai-java</artifactId>
        <version>${openai.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.genai</groupId>
        <artifactId>google-genai</artifactId>
        <version>${google-genai.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson-annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-generator</artifactId>
        <version>${victools.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-module-jackson</artifactId>
        <version>${victools.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <!-- The TCK's contracts are main-scope classes that import only the annotation/assertion
           API, never the engine: nessy-tck depends on this artifact directly (not the
           junit-jupiter aggregator, which would drag junit-jupiter-engine into every consumer's
           main scope). -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.nessy</groupId>
        <artifactId>nessy-tck</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <!-- logback-classic 1.6.1 requires its matching logback-core; left unpinned, Boot's own BOM
           (imported per-module, e.g. nessy-examples/chat-web) wins with an older logback-core and
           the pair mismatches at runtime (AbstractMethodError: PatternLayoutBase#getDefaultConverterMap
           — a method logback-core 1.5.x doesn't yet declare). Only surfaces once something actually
           boots logback at runtime, which is why the container smoke test (the reactor's first
           @SpringBootTest) is what catches it. -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.uuid</groupId>
        <artifactId>java-uuid-generator</artifactId>
        <version>${jug.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-core</artifactId>
        <version>${mcp-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json-jackson2</artifactId>
        <version>${mcp-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-classpath-only SLF4J provider: victools brings slf4j-api transitively,
         and without a provider every log line in a test run is silently dropped.
         logback-classic (not slf4j-simple), managed once here, so build output shows our own
         warnings; each consuming module's src/test/resources/logback-test.xml configures the
         pattern. nessy-examples adds it compile-scope instead, below, and supplies its own
         logback.xml — examples are apps, and apps pick their own provider. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- Tests that spend real tokens are tagged `live`. The default
                 build stays green with no API key and no network. -->
            <excludedGroups>${nessy.excludedGroups}</excludedGroups>
            <argLine>@{jacocoArgLine}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Release profile for Maven Central publishing -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${sonatype.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <tokenAuth>true</tokenAuth>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source.plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>verify</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc.plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>verify</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- CI profile for JaCoCo coverage -->
    <profile>
      <id>ci</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <formats>
                    <format>XML</format>
                  </formats>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- License header check/format -->
    <profile>
      <id>license</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.mycila</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <version>${license.plugin.version}</version>
            <configuration>
              <properties>
                <owner>${license.owner}</owner>
              </properties>
              <licenseSets>
                <licenseSet>
                  <inlineHeader><![CDATA[Copyright © ${year} ${owner}

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
                  <excludes>
                    <exclude>**/README</exclude>
                    <exclude>**/README.md</exclude>
                    <exclude>src/test/resources/**</exclude>
                    <exclude>src/main/resources/**</exclude>
                    <exclude>LICENSE</exclude>
                    <exclude>.github/**</exclude>
                    <exclude>**/*.txt</exclude>
                    <exclude>**/*.sh</exclude>
                    <exclude>**/*.md</exclude>
                    <exclude>docs/**</exclude>
                    <exclude>site/**</exclude>
                    <exclude>.mvn/**</exclude>
                    <exclude>mvnw</exclude>
                    <exclude>mvnw.cmd</exclude>
                  </excludes>
                </licenseSet>
              </licenseSets>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
