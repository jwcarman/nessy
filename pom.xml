    <anthropic.version>2.53.0</anthropic.version>
    <openai.version>4.50.0</openai.version>
    <!-- Google's Gen AI Java SDK (Gemini Developer API + Vertex AI), GA line. Current
         release as of this module's creation (2026-08-15); see java-genai's GitHub
         releases for newer lines. -->
    <google-genai.version>1.66.0</google-genai.version>
    <!-- AWS SDK for Java v2 (bedrockruntime, Converse/ConverseStream). Managed via the SDK's
         own BOM (like micrometer/testcontainers below) rather than a single artifact version,
         since bedrockruntime pulls sibling AWS modules (regions, auth, sdk-core, netty-nio-client)
         that must resolve to one consistent line. Newest stable line on Maven Central as of this
         module's creation (2026-08-16). -->
    <awssdk.version>2.46.7</awssdk.version>
    <jackson.version>2.22.0</jackson.version>
    <!-- jackson-annotations diverged from jackson-databind's version scheme
         starting with the 2.22 line (no patch digit) — kept as a separate
         property so each artifact resolves to a version that actually
         exists. -->
    <jackson-annotations.version>2.22</jackson-annotations.version>
    <!-- org.jwcarman.codec: Central releases only, no snapshots. 0.7.0 is the first release
         carrying codec-transforms, codec-crypto, codec-zstd and codec-lz4 — the appendable
         byte[] -> byte[] set the shared codec pipeline composes.

         The VALUE codec stays codec-jackson2. Not inertia: our types carry Jackson annotations,
         and Jackson 2 measured MUCH faster than 3 in James's benchmarks (2026-08-28). 0.7.0 also
         ships codec-jackson (Jackson 3); we deliberately do not use it. -->
    <codec.version>0.7.0</codec.version>
    <!-- org.jwcarman.continuum 0.4.0 (Central release): the durable-computation
         library Nessy adopts for pending/deadline/expiry/memoized-outcome/outbox
         (2026-08-24 continuum-adoption spec). 0.4.0 is the line whose
         continuum-jdbc certifies PostgreSQL, MySQL and MariaDB on every build
         and selects the dialect rather than merely refusing impostors. -->
    <continuum.version>0.4.0</continuum.version>
    <!-- victools 5 migrated jsonschema-generator's ObjectNode return types from
         com.fasterxml.jackson.databind to tools.jackson.databind (Jackson 3),
         breaking Schemas.java's direct assignment to a Jackson 2 ObjectNode.
         Held at 4.38: victools 5 breaks Schemas.java (Jackson 2 -> 3 node type
         migration) -->
    <victools.version>4.38.0</victools.version>
    <!-- Matches the slf4j-api version victools pulls transitively. -->
    <slf4j.version>2.0.16</slf4j.version>
    <logback.version>1.6.1</logback.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <!-- Bumped from 1.16.2 (agentic-o11y): micrometer-tracing-bridge-otel 1.7.1 (below) compiles
         against micrometer-observation 1.17.1, and the observed example's dependencyManagement-
         pinned micrometer-observation must be the same line the bridge was built against. -->
    <micrometer.version>1.17.1</micrometer.version>
    <!-- Micrometer Tracing (agentic-o11y spec §4): the bridge from a Micrometer Observation to a
         real OpenTelemetry span, application-side only — nessy-agent never depends on this. -->
    <micrometer-tracing.version>1.7.1</micrometer-tracing.version>
    <!-- OpenTelemetry SDK + OTLP exporters (agentic-o11y spec §4): the trace half of the
         observed example's export path, application-side only. -->
    <opentelemetry.version>1.65.0</opentelemetry.version>
    <!-- The OTel logback appender, application-side only (observed example). Its artifact version
         carries the perpetual "-alpha" suffix every opentelemetry-java-instrumentation module
         uses — a versioning convention for that project, not a sign of abandonment; it is
         published on every release. Pinned to the release whose declared opentelemetry-api
         dependency (1.65.0) matches opentelemetry.version above exactly. -->
    <opentelemetry-logback-appender.version>2.31.1-alpha</opentelemetry-logback-appender.version>
    <jug.version>5.2.0</jug.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <!-- Held at the 1.21 line deliberately: testcontainers 2.0 renamed every module artifact
         (org.testcontainers:postgresql -> org.testcontainers:testcontainers-postgresql) and moved
         the container classes to per-module packages. 2.0.x still ships the old
         org.testcontainers.containers.PostgreSQLContainer<?> shape nessy-jdbc's container
         test relies on as a deprecated shim, so this isn't a compatibility blocker — migrating is
         a small deferred follow-up, not a reason to skip 2.0 forever. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Condition-based waiting for concurrency tests (S2925: no Thread.sleep in tests). Managed
         here directly, unlike nessy-autoconfigure, which inherits the version from its own Boot
         BOM import — nessy-console pulls no Spring BOM at all. -->
    <awaitility.version>4.3.0</awaitility.version>
    <postgresql.version>42.7.13</postgresql.version>
    <!-- The MCP Java SDK's 2.0.0 line splits its JSON backend into a separate artifact
         (mcp-json-jackson2 vs. mcp-json-jackson3); nessy-tool-mcp pulls the core artifact
         plus the jackson2 backend explicitly rather than the `mcp` facade, which defaults
         to jackson3 (com.fasterxml.jackson.core's Jackson 2 line is what the rest of this
         repo, including ToolSpec's ObjectNode, is built on). -->
    <mcp-sdk.version>2.0.0</mcp-sdk.version>
    <!-- Spring Boot, for nessy-spring-boot-starter (watchman spec §1). Current stable line on
         Maven Central as of this module's creation (2026-08-26); 4.2.0-M1 is a milestone, not a
         release. The version is pinned HERE, with every other version property, but the
         spring-boot-dependencies BOM is imported ONLY in nessy-spring-boot-autoconfigure's own POM —
         never in this one.

         Measured, not assumed: importing that BOM into this dependencyManagement re-versions the
         whole reactor even when it is declared last, because Boot manages CHILD artifacts this POM
         does not pin. A `dependency:tree` diff on nessy-agent before and after showed
         jackson-core 2.22.0 -> 2.21.5 (against a still-pinned jackson-databind 2.22.0 — a split
         Jackson pair), junit-platform/jupiter-engine 6.1.3 -> 6.0.3 (against a still-pinned
         junit-jupiter 6.1.3), plus mockito, byte-buddy, protobuf, gson and hamcrest. Declaration
         order does not save it: order only decides between two entries for the SAME artifact, and
         these are artifacts nothing here manages at all. Per-module import keeps Boot's opinion
         inside the one module that wants it — which is also what this repo's own comments (above,
         on awaitility and logback-core) describe as the established convention. -->
    <spring-boot.version>4.1.1</spring-boot.version>

    <!-- Spring Framework, taken as a LIBRARY, never as a framework: nessy-spi uses JdbcClient,
         ResourceDatabasePopulator and EmbeddedDatabaseBuilder, all of which work from a bare
         DataSource with no ApplicationContext and no Spring Boot. That is what lets a plain main()
         (nessy-console) and a Boot application share one storage layer.

         Pinned per-artifact below rather than by importing spring-framework-bom, for the reason
         recorded above on spring-boot-dependencies: importing a BOM here re-versions the whole
         reactor through artifacts this POM does not pin. spring-jdbc brings spring-core,
         spring-beans and spring-tx transitively at its own line, which is self-consistent. -->
    <spring-framework.version>7.0.9</spring-framework.version>
    <!-- H2, in-memory, for tests only: "in memory" is a DataSource choice rather than a second
         store implementation, so there is exactly one store per purpose and no fake that can lie
         about what SQL does. -->
    <h2.version>2.3.232</h2.version>

    <!-- Test groups the default build skips. Override to empty to run them:
         ./mvnw test -Dnessy.excludedGroups= -->
    <nessy.excludedGroups>live,container</nessy.excludedGroups>

    <!-- exec-maven-plugin's `java` goal has no lifecycle binding of its own: invoked bare from the
         command line (`mvn exec:java`), Maven runs it once per project in the resolved reactor, not
         just the one named by -pl. In an -am build that reactor always includes this root aggregator
         and every intermediate one, none of which configure `mainClass` — so the bare goal fails here
         before it ever reaches the example that wanted it. Defaulting exec.skip to true here makes
         every project a no-op for that goal by default; the one or two example modules that actually
         run `exec:java` (hello, chat-cli) override it back to false in their own pom.

         mainClass is a required parameter that Maven validates before the mojo's own skip check ever
         runs, so exec.skip alone is not enough — every project needs *some* resolvable value here too,
         even though skip=true means it is never actually loaded. This placeholder is that value; the
         same opting-in modules override it to their own main class. -->
    <exec.skip>true</exec.skip>
    <exec.mainClass>none</exec.mainClass>

    <!-- Build plugin versions (pinned explicitly since this POM has no parent
