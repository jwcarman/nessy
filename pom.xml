    <!-- Test-classpath-only SLF4J provider: victools brings slf4j-api transitively,
         and without a provider every log line in a test run is silently dropped.
         logback-classic (not slf4j-simple), managed once here, so build output shows our own
         warnings; each consuming module's src/test/resources/logback-test.xml configures the
         pattern. nessy-examples adds it compile-scope instead, below, and supplies its own
         logback.xml — examples are apps, and apps pick their own provider. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
