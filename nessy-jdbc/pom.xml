<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-jdbc</artifactId>
  <name>Nessy JDBC</name>
  <description>The reference durable ConversationStore, against Postgres over plain JDBC.</description>

  <properties>
    <!-- The four non-Postgres vendor drivers, test-scope only (this module speaks java.sql
         against a caller-supplied DataSource at runtime; it never depends on a driver itself).
         None of these are Boot-BOM-managed here: spring-boot-dependencies (which does manage all
         four, verified against the 4.1.0 line nessy-autoconfigure imports — mysql-connector-j
         9.7.0, mariadb-java-client 3.5.8, mssql-jdbc 13.4.0.jre11, ojdbc11 23.26.2.0.0) is
         imported only in nessy-autoconfigure's own dependencyManagement, which is local to that
         module and does not cascade here — "Spring enters the reactor only" there, per that pom's
         own comment. So every one of the four is pinned as a property instead. Where Task 2's
         live SQLState verification (see its report) already exercised a specific driver version
         against the same container image this module's matrix pins, that exact version is reused
         here rather than picking a newer one blind: mysql-connector-j and mssql-jdbc and ojdbc11
         below are Task 2's own tested versions. MariaDB's live verification never went through
         JDBC (see the report's caveat), so mariadb-java-client is pinned to the newest 3.5.x line
         release available, rather than reusing an untested pin. -->
    <mysql-connector-j.version>9.4.0</mysql-connector-j.version>
    <mariadb-java-client.version>3.5.6</mariadb-java-client.version>
    <mssql-jdbc.version>12.8.1.jre11</mssql-jdbc.version>
    <ojdbc11.version>23.26.3.0.0</ojdbc11.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-core</artifactId>
    </dependency>
    <!-- Runtime, not compile: the store speaks only java.sql against a caller-supplied
         DataSource. The driver is what makes that DataSource a Postgres one, needed at
         runtime and in this module's own tests, never at compile time. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-tck</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The vendor matrix (design §6): one Testcontainers module per non-Postgres dialect, plus
         its matching JDBC driver. Versions for all four Testcontainers modules come from
         testcontainers-bom, imported once in the root pom — none needed here. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mariadb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql-connector-j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>${mariadb-java-client.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${mssql-jdbc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc11.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- OracleStoreTckTest's own connection retry (see its DriverManagerDataSource javadoc): the
         gvenzl/oracle-free listener, confirmed live in this task's own verification runs,
         intermittently refuses a fresh connection (ORA-12516) under this test suite's rapid,
         unpooled connection churn even well after the container itself reports ready. Version
         managed by the root pom's dependencyManagement — same artifact nessy-autoconfigure and
         nessy-console already depend on for condition-based waiting. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.jdbc</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
