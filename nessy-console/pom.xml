<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-console</artifactId>
  <name>Nessy Console</name>
  <description>One call from a main method to a working terminal agent</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The model comes from whichever credentials are in the environment: a minimal Boot context
         (web-application-type NONE), and the starter's auto-configuration for whichever adapter is
         on the classpath contributes the InferenceProvider bean. The auto-configurations all live
         in nessy-spring-boot-autoconfigure now, so that is what rides along; the ADAPTERS remain
         the application's choice. The engine's own auto-configuration is excluded by the
         bootstrap: the console builds its factory by hand. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <!-- No Boot BOM import here (deliberately, per spring-boot.version's comment in the root
           POM): a per-module BOM import re-versions every artifact Boot has its own opinion about,
           even declared last. Pinning the one Boot artifact this module actually uses, directly,
           keeps that blast radius to this dependency alone. -->
      <version>${spring-boot.version}</version>
    </dependency>
    <!-- A real run, in a test: an adapter to find, a database to keep the agent in. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-openai</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
