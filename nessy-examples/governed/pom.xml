<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-governed</artifactId>
  <name>Nessy Example: Governed</name>
  <description>The full gate as consumer code: a sealed intent vocabulary, a risk-assessing
    enricher, and allOf(requireDeclared, threshold) narrating one scripted turn end to end</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- Opts back into exec:java, which the root pom defaults off (see its own comment) — this is
         the one module in the reactor whose whole point is running that goal. -->
    <exec.skip>false</exec.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile scope, unlike every other module's test-only ScriptedModelProvider: this demo's
         whole point is that its one narrated run needs no real provider at all, so the scripted
         one is the demo's provider, not a test fixture. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <!-- Compile-scope, as in every other example: examples are runnable apps, and an app picks
         its own SLF4J provider rather than inheriting the build's test-classpath default. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <!-- The one main this module has: no -Dexec.mainClass needed on the command line. -->
          <mainClass>org.jwcarman.nessy.examples.governed.Governed</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
