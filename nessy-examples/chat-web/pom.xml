<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-chat-web</artifactId>
  <name>Nessy Example: Chat Web</name>
  <description>A Spring Boot chat app dogfooding the durable kernel: Postgres, restarts, humans clicking approve</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>

    <spring-boot.version>4.1.0</spring-boot.version>

    <!-- Must stay aligned with the opentelemetry-core version Spring Boot manages
         (<opentelemetry.version>, 1.62.0 as of Boot 4.1.0). Boot's BOM is imported first (below)
         and wins, so a newer instrumentation release resolves its own core away: 2.26.x+ calls
         the stable LogRecordBuilder.setException(), which only exists in otel-api 1.60.1+. Boot
         4.0.6 managed 1.55.0, below that floor, so mocapi-enterprise-demo (this recipe's source)
         pins the 2.21.0-alpha line, which routes through the guarded incubator interface present
         in 1.55.0 instead. Boot 4.1.0 manages 1.62.0 — at or above the 1.60.1 floor — so this pin
         is bumped to the 2.26.x line per that same rule. Bump this only alongside Boot's managed
         opentelemetry version. -->
    <opentelemetry-instrumentation.version>2.30.0-alpha</opentelemetry-instrumentation.version>
    <!-- Pinned to match mocapi-enterprise-demo (this recipe's source), which pins the same
         version for the same reason: nothing here manages it for us. -->
    <datasource-micrometer.version>2.2.1</datasource-micrometer.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Declared here, ahead of spring-boot-dependencies below, so the root pom's deliberate
           1.21 pin (see its testcontainers.version comment) keeps winning: a BOM import declared
           directly in THIS pom's dependencyManagement takes precedence over the same GA managed
           by an ancestor pom's import, so without this explicit re-import spring-boot-dependencies
           (4.1.0, testcontainers 2.0.5) would shadow the parent's pin for the bare
           org.testcontainers:testcontainers artifact pulled transitively by
           spring-boot-testcontainers below — a version split from the 1.21-line
           testcontainers-postgresql/junit-jupiter test dependencies that made
           {@code @ServiceConnection} fail to find any container's connection details at all
           (the identical split order-desk's own pom fixed the same way). -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring enters the reactor only here: this import, and nowhere else in the build.
           Declared second so testcontainers-bom above keeps winning that one GA; Boot's BOM
           still wins dependency-version conflicts over anything the alpha BOM below prefers
           for every other artifact. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
        <version>${opentelemetry-instrumentation.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Boot 4's default web stack auto-configures a Jackson 3 (tools.jackson) ObjectMapper;
         nessy-core and every bean in this module (ChatWebConfig, ChatController, ApprovalController)
         are written against classic Jackson 2 (com.fasterxml.jackson.databind). This module pulls
         Boot's own backward-compat auto-configuration for that generation back in. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson2</artifactId>
    </dependency>
    <!-- Boot 4's default logging starter only bridges Log4j2/JUL onto SLF4J; it ships no SLF4J
         binding of its own. Compile-scope, unlike every other module's test-only provider (see
         nessy-parent's own root <dependencies> comment): examples are runnable apps, and an app
         picks its own SLF4J provider — this one to make logback-spring.xml's OTel appender real. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Makes `mvn spring-boot:run` start (and stop) docker-compose.yml automatically: Postgres
         plus the LGTM observability stack. Optional: an application jar built from this module
         never requires it on its own runtime classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Observability (design §5a): traces, metrics, and logs all shipped over OTLP to the
         grafana/otel-lgtm compose service. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <!-- Logback -> OTel LogRecord bridge (logback-spring.xml's OTEL appender +
         OpenTelemetryAppenderInitializer). Version comes from the alpha BOM import above. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-logback-appender-1.0</artifactId>
    </dependency>
    <!-- JDBC observability: wraps the DataSource so every SQL statement emits a Micrometer
         Observation. Those Observations flow through the MicrometerTracing -> OTel bridge
         already wired by spring-boot-starter-opentelemetry above, so SQL spans end up on the
         same OTLP pipeline as the handler and HTTP spans (README's "one trace" claim). Mirrors
         mocapi-enterprise-demo's pin. -->
    <dependency>
      <groupId>net.ttddyy.observation</groupId>
      <artifactId>datasource-micrometer-spring-boot</artifactId>
      <version>${datasource-micrometer.version}</version>
    </dependency>
    <!-- Maps datasource-micrometer's legacy jdbc.* attributes onto OTel DB semconv (db.query.text,
         db.system.name, db.operation.name, db.response.returned_rows). Auto-activates when
         present on the classpath. -->
    <dependency>
      <groupId>net.ttddyy.observation</groupId>
      <artifactId>datasource-micrometer-opentelemetry</artifactId>
      <version>${datasource-micrometer.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- The house bans mocking libraries (no test doubles from a framework); Boot's test
             starter pulls Mockito in transitively, so it is excluded explicitly. -->
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Boot 4 split TestRestTemplate out of spring-boot-test into its own module; the starter
         above no longer pulls it in transitively. TestRestTemplateTestAutoConfiguration itself
         needs RestTemplateBuilder (spring-boot-restclient), which the RestClient-first web starter
         no longer brings in either. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ChatController and ApprovalController resolve @PathVariable("id")-less parameters
           (@PathVariable String id, @PathVariable String token) by matching the compiled parameter
           name itself; nessy-parent's own compiler config never sets -parameters (only Boot's
           starter-parent does, which this reactor doesn't inherit from), so without this override
           every such endpoint 500s at request time — javac strips parameter names by default. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <!-- Version and repackage-goal wiring come from the BOM's pluginManagement (imported
           above); no repackage execution is declared here — `spring-boot:run` needs none. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
