<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-scout</artifactId>
  <name>Nessy Example: Scout</name>
  <description>Runnable example: an imported MCP toolbox, granted tool-by-tool, against DeepWiki's public server.</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- Opts back into exec:java, which the root pom defaults off (see its own comment) — this
         module runs that goal on purpose. -->
    <exec.skip>false</exec.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- DeepWiki's tools, opened as nessy Tools over the official MCP Java SDK. The SDK's HTTP
         transport (io.modelcontextprotocol.client.transport.HttpClientStreamableHttpTransport)
         rides plain java.net.http.HttpClient, so no transport-extra dependency is needed beyond
         what nessy-tool-mcp already pulls (mcp-core + mcp-json-jackson2). -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-tool-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile-scope, unlike every other module's test-only provider: examples are runnable
         apps, and an app picks its own SLF4J provider rather than inheriting the build's
         test-classpath default. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
