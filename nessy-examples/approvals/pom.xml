<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-approvals</artifactId>
  <name>Nessy Example: Approvals</name>
  <description>The harness door plus a desk: one DURABLE tool behind requireApproval(), a
    console loop, and a scripted arc that needs no key</description>

  <properties>
    <!-- Examples are never published: this module's own maven.deploy.skip keeps the deploy
         goal from running here, and the aggregator's maven.source.skip/maven.javadoc.skip/
         gpg.skip keep the release profile's source jar, javadoc jar, and signing step off this
         module too. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- Opts back into exec:java, which the root pom defaults off (see its own comment) — this is
         the one module in the reactor whose whole point is running that goal. -->
    <exec.skip>false</exec.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-env</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile scope, unlike every other module's test-only ScriptedModelProvider: this demo's
         whole point is that it runs with no real provider at all when the scripted flag is given,
         so the scripted one is the demo's provider, not a test fixture. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <!-- Compile-scope, as in every other example: examples are runnable apps, and an app picks
         its own SLF4J provider rather than inheriting the build's test-classpath default. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <!-- The one main this module has: no -Dexec.mainClass needed on the command line. -->
          <mainClass>org.jwcarman.nessy.examples.approvals.Approvals</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
