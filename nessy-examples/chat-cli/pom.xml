<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-chat-cli</artifactId>
  <name>Nessy Example: Chat CLI</name>
  <description>The smallest thing that talks to an agent: one terminal, one call</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec.skip>false</exec.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-console</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The prompt is a template: ${today} is filled in per call, so the date is never stale. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-prompt</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-prompt-spring</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-memory-notebook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-planning</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Each of these ships its own @AutoConfiguration, so this is the whole provider choice: the
         Boot context Repl.run() raises finds whichever one's API key is in the environment and
         contributes the ModelProvider bean. Three of them, so one command runs against any of four
         vendors (xAI rides in the OpenAI module, being that wire at a different URL). Bedrock is
         deliberately not a Boot citizen here: ambient AWS credentials mean someone once deployed
         something, not that they chose it. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <!-- No Boot BOM import here: see nessy-console/pom.xml's comment on the same tradeoff.
           Already on this module's classpath transitively through nessy-console; declared directly
           because it is what Repl.run() needs underneath it, the same way the provider adapters
           above are declared directly rather than left to a transitive accident. -->
      <version>${spring-boot.version}</version>
    </dependency>
    <!-- The engine's schema is PostgreSQL's; the driver rides along at runtime. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.jwcarman.nessy.examples.chatcli.Chat</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
