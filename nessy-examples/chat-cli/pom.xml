<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-chat-cli</artifactId>
  <name>Nessy Example: Chat CLI</name>
  <description>The smallest thing that talks to an agent: one terminal, one call</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec.skip>false</exec.skip>
  </properties>


  <dependencies>
    <!-- The starter: the direct-door factory, the provider registry (nessy.provider and
         nessy.model choose which registered provider answers) and the codec factory. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-console</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Schemas.initialize: this example creates its own tables rather than having a framework
         run a DDL file behind its back. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-backend-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-memory-notebook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-planning</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- InferenceProvidersAutoConfiguration registers a named InferenceProvider bean per lit
         preset and per custom provider; the two dependencies below light the openai, xai and
         anthropic presets, so one command runs against any of three vendors. NESSY_PROVIDER
         chooses which registered provider answers. Bedrock is deliberately not a Boot citizen
         here: ambient AWS credentials mean someone once deployed something, not that they chose
         it. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The engine's schema is PostgreSQL's; the driver rides along at runtime. -->
    <!-- A pooled DataSource for Boot to hand the compose-started database over as. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Boot starts the database in compose.yaml when the example runs, and stops it after. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The engine's schema is PostgreSQL's, so the startup test runs against one in a container. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.jwcarman.nessy.examples.chatcli.Chat</mainClass>
          <!-- exec:java runs inside Maven's own JVM, whose working directory is wherever Maven
               was started, so Boot would look for compose.yaml there. Named absolutely, the
               command works from the repo root as well as from this directory. -->
          <systemProperties>
            <systemProperty>
              <key>spring.docker.compose.file</key>
              <value>${project.basedir}/compose.yaml</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
