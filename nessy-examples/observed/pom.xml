<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-observed</artifactId>
  <name>Nessy Example: Observed</name>
  <description>The numbers the soak needs: hello's turn, exported as OTel GenAI spans and metrics</description>

  <properties>
    <!-- Examples are never published: this module's own maven.deploy.skip keeps the deploy
         goal from running here, and the aggregator's maven.source.skip/maven.javadoc.skip/
         gpg.skip keep the release profile's source jar, javadoc jar, and signing step off this
         module too. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- Opts back into exec:java, which the root pom defaults off (see its own comment) — this is
         one of the few modules in the reactor whose whole point is running that goal. -->
    <exec.skip>false</exec.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- One provider, exactly as hello does — this module's point is the observability wiring,
         not a provider tour. Swap for nessy-model-openai/nessy-model-gemini/nessy-model-bedrock
         and the export side is untouched. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-discovery</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile scope, as in hello: the scripted flag needs no key, no network, no Docker. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>

    <!-- The observability seam's application side (agentic-o11y spec §4): everything below lives
         here, never in nessy-agent, which depends on micrometer-observation alone. -->

    <!-- (a) traces: micrometer-tracing-bridge-otel turns an Observation into a Micrometer Span
         over a real OpenTelemetry SDK Tracer; opentelemetry-exporter-otlp ships that Tracer's
         spans to a collector over OTLP/gRPC. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!-- (b) metrics: DefaultMeterObservationHandler times every Observation onto whatever
         MeterRegistry it is built with; OtlpMeterRegistry ships those meters over OTLP/HTTP. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <!-- logs: the OTel logback appender ships this module's own log lines alongside the spans and
         metrics above, correlated by trace id. A maintained artifact (published on every
         opentelemetry-java-instrumentation release; the perpetual "-alpha" suffix is that
         project's own versioning convention for every instrumentation module, not a sign of
         abandonment — see the README). -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-logback-appender-1.0</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The tests must not publish into a live collector (soak finding F4, 2026-08-26).
           ObservedTest runs the REAL export paths on purpose — that is its subject — so on the
           soak host every `mvn verify` was injecting spans under service.name=nessy-example-observed
           into whatever was listening on localhost:4317/4318, indistinguishable from a real run.
           Observed reads its endpoints from OTEL_EXPORTER_OTLP_ENDPOINT (there is no system
           property seam and inventing one would be production code written for a test), so the
           tests are given a closed port on loopback: exports still run, still fail lazily, still
           get dropped rather than thrown — which is exactly what this module claims — and nothing
           leaves the machine. Port 1 refuses immediately; a black-holed address would make every
           export wait for a timeout instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <OTEL_EXPORTER_OTLP_ENDPOINT>http://127.0.0.1:1</OTEL_EXPORTER_OTLP_ENDPOINT>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <!-- The one main this module has: no -Dexec.mainClass needed on the command line. -->
          <mainClass>org.jwcarman.nessy.examples.observed.Observed</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
