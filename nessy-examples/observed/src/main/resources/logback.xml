<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Logs, ridden alongside the traces and metrics: the OTel logback appender ships every event
       to the collector's OTLP/gRPC log endpoint, correlated to whichever span is current on the
       logging thread. Its own export failures follow the same rule as the trace/metric exporters
       (README: "Running with no collector") — never thrown, only dropped, so console logging keeps
       working with no collector listening. -->
  <appender name="OTLP" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTLP"/>
  </root>

  <logger name="org.jwcarman.nessy" level="WARN"/>
  <logger name="io.opentelemetry" level="WARN"/>
</configuration>
