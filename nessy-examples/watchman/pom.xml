<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-watchman</artifactId>
  <name>Nessy Example: Watchman</name>
  <description>The soak: a Spring Boot agent that does rounds on a Linux box and waits days for a human</description>

  <properties>
    <!-- Examples are never published: this module's own maven.deploy.skip keeps the deploy
         goal from running here, and the aggregator's maven.source.skip/maven.javadoc.skip/
         gpg.skip keep the release profile's source jar, javadoc jar, and signing step off this
         module too. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- HTMX, from a webjar rather than a CDN: the box this runs on is a LAN server that may have
         no outbound internet at all, and an approval page that cannot render without one is not a
         page you can trust in an outage. The version appears in the template's script path. -->
    <htmx.version>2.0.4</htmx.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot's BOM, imported HERE and imported LAST, for exactly the reasons
           nessy-spring-boot-starter's own pom spells out: importing it into the parent re-versions
           every module in the reactor, and everything declared ABOVE it wins, because Maven
           resolves competing managed entries for one artifact in declaration order. The block
           below re-states the versions this repo pins for artifacts Boot also has an opinion
           about, so this module runs on the same jackson, junit, logback, postgresql and
           testcontainers as every other module. Micrometer, OpenTelemetry and Spring itself are
           left to Boot: this is a Boot application, and Boot's whole value is the combination it
           tested. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
      </dependency>
      <!-- OpenTelemetry pinned to the repo's version rather than Boot's, and it has to be: the
           logback appender (2.31.1-alpha, pinned in the parent) drags in opentelemetry-api-incubator
           at 1.65.0-alpha, and Boot 4.1.1 manages opentelemetry-api at 1.62.0. That split pair fails
           at runtime with ClassNotFoundException on io.opentelemetry.api.incubator.common.
           ExtendedAttributeKey the moment the appender is installed — the exact class of breakage
           the parent's own logback-core comment warns about. Importing the BOM here puts api and
           incubator back on the same line, and matches what nessy-examples/observed already runs. -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The whole harness, from beans. Nothing in this module wires a Nessy type by hand. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The durable pair the starter wires when it finds them beside a DataSource. An agent that
         parks approvals for days and survives reboots is the entire point of the soak, so these
         are not optional here. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-substrate-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.continuum</groupId>
      <artifactId>continuum-jdbc</artifactId>
    </dependency>
    <!-- One provider, as in hello and observed. Discovery arrives through the starter. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Compile scope, as in hello: the scripted mode is a mode of the application, not a test
         fixture. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-testing</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
      <version>${htmx.version}</version>
    </dependency>

    <!-- Telemetry (watchman spec §2.3). The actuator owns the ObservationRegistry, and the starter
         hands it to the harness's seam. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- The OTLP wires, and the reason this is ONE starter rather than the three runtime libraries
         it contains.

         nessy-examples/observed declares micrometer-tracing-bridge-otel, opentelemetry-exporter-otlp
         and micrometer-registry-otlp directly, and builds the SDK by hand — correct there, because
         it is a Boot-free main(). Copying that shape into a Boot 4 application produces a build that
         compiles, starts, exports METRICS, and silently exports no traces and no logs at all: Boot 4
         moved tracing and OTLP autoconfiguration out of spring-boot-actuator-autoconfigure into
         separate module jars (spring-boot-micrometer-tracing-opentelemetry, spring-boot-opentelemetry),
         and those arrive only through this starter. Without it there is no OpenTelemetry bean, no
         SdkTracerProvider, no span exporter — so management.otlp.tracing.* and
         management.tracing.sampling.* bind to nothing and Tempo stays empty.

         The starter SUBSUMES all three libraries above (see its own pom: micrometer-registry-otlp,
         micrometer-tracing-bridge-otel, opentelemetry-exporter-otlp, all runtime), which is why they
         are no longer declared here. TelemetryWiringTest asserts the beans exist, so this cannot
         regress silently again. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Logs, correlated to the spans by trace id. NOT brought by the starter, and not installed by
         Boot either: the appender has to be handed the OpenTelemetry instance at startup, which is
         what Telemetry#openTelemetryAppenderInstaller does. The perpetual "-alpha" suffix is the
         opentelemetry-java-instrumentation project's versioning convention for every instrumentation
         module, not a sign of abandonment — see nessy-examples/observed's README. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-logback-appender-1.0</artifactId>
      <version>${opentelemetry-logback-appender.version}</version>
    </dependency>
    <!-- Compile scope, because Telemetry names OpenTelemetryAppender and its supertype lives here.
         spring-boot-starter-logging brings logback at RUNTIME only, which is enough to log and not
         enough to compile against the appender. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- SQL spans (soak finding F5, 2026-08-26). Spring Boot instruments no JDBC out of the box —
         measured by listing the built application's 132 jars, none of which is a JDBC
         instrumentation — so search_memory and create_memory had no children at all and "is recall
         slow, or is the transcript huge?" could not be answered from the trace. This wraps the
         DataSource and records each query as a Micrometer Observation, which lands under whichever
         memory observation is open.

         Declared HERE and nowhere else, deliberately: it is an APPLICATION's choice to have its
         DataSource wrapped, never nessy-agent's and never the starter's. Version pinned in the
         root pom's dependencyManagement with every other version. -->
    <dependency>
      <groupId>net.ttddyy.observation</groupId>
      <artifactId>datasource-micrometer-spring-boot</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <!-- The no-mocking-library promise (design of record), enforced by the build rather than by
           discipline. Every seam this module tests through is a hand-written fake. -->
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Boot 4 split the test slices out of spring-boot-test-autoconfigure: MockMvc's
         @AutoConfigureMockMvc now lives in org.springframework.boot.webmvc.test.autoconfigure,
         shipped by this starter rather than by spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
