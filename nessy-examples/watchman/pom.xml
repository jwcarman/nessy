<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-watchman</artifactId>
  <name>Nessy Example: Watchman (Pekko port)</name>
  <description>The watchman on the actor runtime. NO LONGER A SPIKE: as of 2026-08-28 this is where
    Nessy's Pekko-based engine is being built, and the design here is the design of record rather
    than a comparison. It depends on nessy-spi, nessy-agent and
    nessy-model-openai deliberately — the transcript, memory fold, substrate and model client are
    Nessy's and are reused rather than reinvented. An earlier description claimed the opposite on
    both counts.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <pekko-persistence-jdbc.version>1.3.0</pekko-persistence-jdbc.version>
    <htmx.version>2.0.4</htmx.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.pekko</groupId>
        <artifactId>pekko-bom_2.13</artifactId>
        <version>${pekko.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Same ordering rule the sibling watchman documents at length: everything this repo pins
           is declared ABOVE Boot's BOM, so Boot only decides what this repo has no opinion on. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- THE TRANSCRIPT IS NESSY'S, NOT OURS. The soak measured the cost of embedding it in the
         durable state (14x growth in 64 minutes, every revision rewriting the whole document), and
         the fix is an append-only journal, which Nessy already has. nessy-spi's Substrate gives
         its own purpose-built tables over a DataSource;
         puts it on the DataSource Spring already owns. Writing a second journal by hand would have
         been strictly worse. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Memory, and the Remembrance fold that pairs a tool_use with its result. SubstrateMemory
         owns the transcript directly; this port no longer has one of its own. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The real model client: streaming, capability declaration, prompt caching, and a Usage
         that reports cache reads. LM Studio speaks the OpenAI protocol, so this is the provider
         that talks to it, pointed at a different base URL, exactly as XaiModelProviderBootstrap
         points it at x.ai. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-openai</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The actor runtime. -->
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-cluster-sharding-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-typed_2.13</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-jdbc_2.13</artifactId>
      <version>${pekko-persistence-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-slf4j_2.13</artifactId>
    </dependency>

    <!-- The BINDING behind pekko-slf4j. Without it SLF4J finds no provider, falls back to its
         NOP logger, and every line this application and Pekko write goes nowhere — the first
         soak attempt produced a running process and an empty log file. The original watchman
         declares logback for the same reason; the starters used here do not drag it in. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- Jackson 2, DECLARED EXPLICITLY. Boot 4 ships Jackson 3 (tools.jackson) in its web
         starter, so com.fasterxml.jackson.databind is no longer transitively present at all.
         StateSerializer and the model client both use Jackson 2 deliberately: it is the reactor's
         pinned line, and because our serializer is ours, Pekko has no opinion about it either way. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
      <version>${htmx.version}</version>
    </dependency>

    <!-- Telemetry. Traces.java codes against MICROMETER (io.micrometer.tracing.Tracer and
         Propagator), not OpenTelemetry: OTel is the implementation underneath via
         micrometer-tracing-bridge-otel, which the Boot starter brings at runtime. The main
         sources contain no io.opentelemetry import at all, which is why opentelemetry-api is
         RUNTIME scope here: runtime is absent from the COMPILE classpath, so the build itself
         now enforces "main code does not touch OTel", while the jar still ships the API and
         tests (which are on the runtime classpath) can still name OTel types deliberately, to
         assert the spans a backend actually receives rather than the bridge's own types.

         SCOPE THIS CAREFULLY, and do not "tidy" it to test. It was briefly TEST scope, and that
         silently destroyed all tracing in the running application. Maven resolves by nearest
         definition, so a direct test-scoped declaration BEATS the transitive compile-scoped one
         from opentelemetry-sdk: the API left the runtime classpath entirely, Boot's tracing
         autoconfiguration is @ConditionalOnClass on those very classes, no Tracer or Propagator
         bean was created, and Traces fell back to the NOOP pair. Every span became a no-op and
         nothing failed: the app ran, the tests passed, and the traces simply stopped existing.
         The tests could not catch it because they construct OtelTracer/OtelPropagator directly
         and never exercise Boot's wiring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Lets TraceTreeTest assert the SHAPE of the trace rather than eyeball it in Grafana.
         Trace context across actor messages is the highest-risk part of this port, so it gets a
         test that fails if the tree ever flattens into orphans. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-testkit-typed_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-persistence-testkit_2.13</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
