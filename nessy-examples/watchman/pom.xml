<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-watchman</artifactId>
  <name>Nessy Example: Watchman</name>
  <description>The watchman on the durable engine. NO LONGER A SPIKE: as of 2026-08-28 the design
    here is the design of record rather than a comparison. It depends on nessy-spi, nessy-agent and
    nessy-model-openai deliberately — the transcript, memory fold, substrate and model client are
    Nessy's and are reused rather than reinvented. An earlier description claimed the opposite on
    both counts.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <htmx.version>2.0.4</htmx.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Same ordering rule the sibling watchman documents at length: everything this repo pins
           is declared ABOVE Boot's BOM, so Boot only decides what this repo has no opinion on. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- THE TRANSCRIPT IS NESSY'S, NOT OURS. The soak measured the cost of embedding it in the
         durable state (14x growth in 64 minutes, every revision rewriting the whole document), and
         the fix is an append-only journal, which Nessy already has. nessy-spi's Substrate gives
         its own purpose-built tables over a DataSource;
         puts it on the DataSource Spring already owns. Writing a second journal by hand would have
         been strictly worse. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The real model client: streaming, capability declaration, prompt caching, and a Usage
         that reports cache reads. LM Studio speaks the OpenAI protocol, so this is the provider
         that talks to it, pointed at a different base URL, exactly as this module's own xAI
         auto-configuration points it at x.ai. -->
    <!-- The gate in front of the prune: assessed, and only the middle band reaches a person. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-approval-risk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-inference-openai</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Without a binding, SLF4J finds no provider, falls back to its NOP logger, and every line
         this application writes goes nowhere — the first soak attempt produced a running process
         and an empty log file. The original watchman declares logback for the same reason; the
         starters used here do not drag it in. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- `spring-boot:run` starts docker-compose.yml beside this pom and takes the database and the
         OTLP endpoint from the containers it started, then stops them on exit. Optional, so the jar
         this example is usually run as (on the box whose disks and containers it watches) does not
         carry it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
      <version>${htmx.version}</version>
    </dependency>

    <!-- Telemetry. Traces.java codes against MICROMETER (io.micrometer.tracing.Tracer and
         Propagator), not OpenTelemetry: OTel is the implementation underneath via
         micrometer-tracing-bridge-otel, which the Boot starter brings at runtime. The main
         sources contain no io.opentelemetry import at all, which is why opentelemetry-api is
         RUNTIME scope here: runtime is absent from the COMPILE classpath, so the build itself
         now enforces "main code does not touch OTel", while the jar still ships the API and
         tests (which are on the runtime classpath) can still name OTel types deliberately, to
         assert the spans a backend actually receives rather than the bridge's own types.

         SCOPE THIS CAREFULLY, and do not "tidy" it to test. It was briefly TEST scope, and that
         silently destroyed all tracing in the running application. Maven resolves by nearest
         definition, so a direct test-scoped declaration BEATS the transitive compile-scoped one
         from opentelemetry-sdk: the API left the runtime classpath entirely, Boot's tracing
         autoconfiguration is @ConditionalOnClass on those very classes, no Tracer or Propagator
         bean was created, and Traces fell back to the NOOP pair. Every span became a no-op and
         nothing failed: the app ran, the tests passed, and the traces simply stopped existing.
         The tests could not catch it because they construct OtelTracer/OtelPropagator directly
         and never exercise Boot's wiring. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The engine's schema is PostgreSQL's, and so is the board's: the tests run against one. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Lets TraceTreeTest assert the SHAPE of the trace rather than eyeball it in Grafana.
         Trace context surviving the hop from a dispatch to the effect it produced is the
         highest-risk part of this port, so it gets a test that fails if the tree ever flattens
         into orphans. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
