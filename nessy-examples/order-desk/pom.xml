<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nessy-example-order-desk</artifactId>
  <name>Nessy Example: Order Desk</name>
  <description>A queue-triggered agent: RabbitMQ delivery initiates each turn, one conversation per order</description>

  <properties>
    <!-- Examples are never published: no jar, sources, or javadoc leaves this module. -->
    <maven.deploy.skip>true</maven.deploy.skip>

    <spring-boot.version>4.1.0</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Declared here, ahead of spring-boot-dependencies below, so the root pom's deliberate
           1.21 pin (see its testcontainers.version comment) keeps winning: a BOM import declared
           directly in THIS pom's dependencyManagement takes precedence over the same GA managed
           by an ancestor pom's import, so without this explicit re-import spring-boot-dependencies
           (4.1.0, testcontainers 2.0.5) would shadow the parent's pin for the bare
           org.testcontainers:testcontainers artifact pulled transitively by
           spring-boot-testcontainers below — a version split from the 1.21-line
           testcontainers-postgresql/rabbitmq/junit-jupiter test dependencies that made
           {@code @ServiceConnection} fail to find any container's connection details at all. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring enters the reactor only inside example modules: this import, confined here,
           exactly the chat-web discipline. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The plain starter: no web of its own — RabbitMQ's management UI is the demo's only
         surface (spec §4). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- The queue as driver: @RabbitListener beans and the AmqpTemplate come from this
         starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- Without this, Boot never auto-configures a DataSource bean at all (no
         DataSourceAutoConfiguration activation, no HikariCP) — nessy-autoconfigure's
         JdbcPersistenceAutoConfiguration is @ConditionalOnBean(DataSource.class) and would
         silently never turn on, and Task 5's smoke test's @ServiceConnection Postgres container
         has nothing to wire into. Same discipline as chat-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Boot 4's default logging starter only bridges Log4j2/JUL onto SLF4J; it ships no SLF4J
         binding of its own. Compile-scope, as in chat-web: examples are runnable apps, and an app
         picks its own SLF4J provider. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The production JacksonJsonMessageConverter bean (OrderDeskConfig) runs on this engine at
         request time, not merely at startup, so it needs a real compile-scope dependency of its
         own — before this was added it reached the module only transitively through the optional
         runtime spring-boot-docker-compose dependency below, which is a coincidence of test/dev
         wiring, not a production guarantee. Version comes from spring-boot-dependencies above. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Durable substrate: the JDBC store and its driver arrive here so kill-and-restart keeps
         both queues' unacked messages and the database's conversations (spec §4). -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Service connections image-detect Postgres and RabbitMQ from docker-compose.yml — no
         coordinates belong in application.yaml (spec §4). Optional: the compose file is a demo
         convenience, not a hard dependency of the jar. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- The house bans mocking libraries (no test doubles from a framework); Boot's test
             starter pulls Mockito in transitively, so it is excluded explicitly. -->
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Version comes from the BOM's pluginManagement. No repackage execution: the demo runs
           `spring-boot:run` (spec §4) — nothing ships a jar. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
