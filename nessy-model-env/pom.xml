<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.nessy</groupId>
    <artifactId>nessy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nessy-model-env</artifactId>
  <name>Nessy Model Env</name>
  <description>The provider follows the key: one fromEnv() that picks Anthropic, OpenAI, Gemini, or xAI (OpenAI-compatible) by which API key is set, or Bedrock by explicit selection only, over all provider modules non-optionally.</description>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-spi</artifactId>
    </dependency>
    <!-- Non-optional, on purpose: this module's whole point is that every provider rides the
         classpath so any key just works, with no per-provider dependency choice left to the
         consumer. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-gemini</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Bedrock rides the classpath the same non-optional way, even though EnvModelProviders
         never key-detects it (design §4: explicit nessy.provider=bedrock only) — so
         NESSY_PROVIDER=bedrock just works without a separate dependency choice, the same promise
         the other three providers make. -->
    <dependency>
      <groupId>org.jwcarman.nessy</groupId>
      <artifactId>nessy-model-bedrock</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.jwcarman.nessy.model.env</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
